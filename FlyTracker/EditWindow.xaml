<Window x:Class="FlyTracker.EditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Изменить вылет" SizeToContent="Height" Width="445" WindowStartupLocation="CenterOwner" Background="#17212D" Foreground="White" ResizeMode="NoResize">
 <StackPanel Margin="20"><TextBlock Text="Название"/><TextBox x:Name="FlightName" Margin="0,4,0,10"/>
 <TextBlock Text="Начало UTC · гггг-ММ-дд ЧЧ:мм:сс"/><TextBox x:Name="StartTime" Margin="0,4,0,10"/>
 <TextBlock Text="Конец UTC · гггг-ММ-дд ЧЧ:мм:сс"/><TextBox x:Name="EndTime" Margin="0,4,0,10"/>
 <TextBlock Text="Заметка"/><TextBox x:Name="Note" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 <TextBlock x:Name="Error" Foreground="#FFB392" TextWrapping="Wrap"/><Button Content="Сохранить" Click="SaveClick" Padding="12,7" Margin="0,12,0,0"/></StackPanel>
</Window>
