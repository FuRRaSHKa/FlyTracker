<Window x:Class="FlyTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FlyTracker · Журнал вылетов" Width="1090" Height="730" MinWidth="840" MinHeight="570" Background="#10151D" Foreground="#E6EEF4" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="14,7"/><Setter Property="Background" Value="#284252"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#17212D"/><Setter Property="Foreground" Value="#DFE9F1"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="5"/><Setter Property="Background" Value="#202E3D"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/></Style>
 </Window.Resources>
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel><TextBlock Text="FlyTracker" FontSize="27" FontWeight="SemiBold" Foreground="#7CE0DC"/>
    <TextBlock x:Name="Status" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" Foreground="#B4C4D2"/></DockPanel>
   <WrapPanel Margin="0,15,0,17"><TextBlock Text="Пилот" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="Pilots" Width="190" VerticalContentAlignment="Center"/>
    <Button x:Name="StartButton" Content="Начать вылет" Click="StartClick" Background="#19695F"/>
    <Button x:Name="StopButton" Content="Завершить" Click="StopClick"/>
    <Button x:Name="FolderButton" Content="Папка журналов…" Click="FolderClick"/></WrapPanel>
  </StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel Background="#17212D"><TextBlock DockPanel.Dock="Top" Text="История вылетов" Margin="12" FontSize="17"/>
    <TextBox DockPanel.Dock="Top" x:Name="Search" Margin="10,0,10,8" ToolTip="Поиск по названию или пилоту" TextChanged="FilterChanged" AutomationProperties.Name="Поиск по истории"/>
    <ListBox x:Name="History" SelectionChanged="FlightSelected" DisplayMemberPath="Caption" Padding="4"/></DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel><Button DockPanel.Dock="Right" x:Name="EditButton" Content="Изменить…" Click="EditClick"/><TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
    <TextBlock Grid.Row="1" x:Name="Dates" Margin="0,7" Foreground="#A8BCCA" TextWrapping="Wrap"/>
    <Border Grid.Row="2" Background="#1B2C39" Padding="13" Margin="0,3,0,8"><TextBlock x:Name="Metrics" Foreground="#9DE4DC" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap"/></Border>
    <StackPanel Grid.Row="3"><TextBlock x:Name="SystemSeen" Foreground="#A8BCCA" Margin="0,2,0,3"/><TextBlock x:Name="Route" MaxHeight="75" TextWrapping="Wrap" Margin="0,2,0,4"/><TextBlock x:Name="Notes" TextTrimming="CharacterEllipsis" Foreground="#A8BCCA" Margin="0,0,0,8"/></StackPanel>
    <TabControl Grid.Row="4" Background="#17212D" BorderThickness="0"><TabItem Header="События"><ListView x:Name="Feed" Background="#17212D" Foreground="#DDE7ED" BorderThickness="0"><ListView.View><GridView>
     <GridViewColumn Header="UTC" Width="78" DisplayMemberBinding="{Binding Clock}"/><GridViewColumn Header="Событие" Width="122" DisplayMemberBinding="{Binding Label}"/>
     <GridViewColumn Header="Урон" Width="62" DisplayMemberBinding="{Binding Value}"/><GridViewColumn Header="Цель / откуда" Width="225" DisplayMemberBinding="{Binding Subject}"/>
     <GridViewColumn Header="Подробности / куда" Width="280" DisplayMemberBinding="{Binding Detail}"/>
    </GridView></ListView.View></ListView></TabItem>
    <TabItem Header="Цели"><ListView x:Name="Targets" Background="#17212D" Foreground="#DDE7ED" BorderThickness="0"><ListView.View><GridView>
     <GridViewColumn Header="Цель по журналу" Width="245" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Нанесено" Width="95" DisplayMemberBinding="{Binding Outgoing}"/>
     <GridViewColumn Header="Получено" Width="95" DisplayMemberBinding="{Binding Incoming}"/><GridViewColumn Header="Попаданий (оба направления)" Width="185" DisplayMemberBinding="{Binding Hits}"/>
    </GridView></ListView.View></ListView></TabItem></TabControl>
   </Grid>
  </Grid>
 </DockPanel>
</Window>

