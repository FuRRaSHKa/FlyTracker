<Window x:Class="FlyTracker.Views.EditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Изменить вылет" SizeToContent="Height" Width="445" WindowStartupLocation="CenterOwner" Background="#17212D" Foreground="White" ResizeMode="NoResize">
 <StackPanel Margin="20"><TextBlock Text="Название"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
 <TextBlock Text="Начало UTC · гггг-ММ-дд ЧЧ:мм:сс"/><TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
 <TextBlock Text="Конец UTC · гггг-ММ-дд ЧЧ:мм:сс"/><TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
 <TextBlock Text="Заметка"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 <TextBlock Text="{Binding Error}" Foreground="#FFB392" TextWrapping="Wrap"/><Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="12,7" Margin="0,12,0,0"/></StackPanel>
</Window>
